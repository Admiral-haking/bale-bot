# ==================== ربات بله / Bale Bot ====================
# Required / الزامی
BALE_BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=your_bale_user_id

# ==================== MongoDB ====================
# Optional / اختیاری
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tebahmadi_bot

# ==================== Logging / لاگینگ ====================
# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== Safir SMS Service / سرویس پیامک سفیر ====================
# Optional / اختیاری
SAFIR_API_KEY=your_safir_api_key
SAFIR_BOT_ID=your_safir_bot_id

# ==================== Bale API / API بله ====================
# Optional - Default: https://tapi.bale.ai
# BALE_API_BASE=https://tapi.bale.ai
